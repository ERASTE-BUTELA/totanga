# Copier ce fichier vers .env puis remplacer les valeurs.
# .env n'est pas versionné et ne doit jamais être publié.

# ---------------------------------------------------------------------------
# Django — communs
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=changez-moi-par-une-cle-longue-et-aleatoire

# Compte administrateur du quotidien (groupe administrateur, pas super-utilisateur).
# Créé seulement au premier démarrage si le compte n'existe pas.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changez-moi

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=totanga
POSTGRES_USER=totanga
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Développement local (docker compose up)
# ---------------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Production (docker compose -f docker-compose.production.yml)
# Remplacer les placeholders par les vrais hôtes quand les sous-domaines
# seront choisis. Exemple avec le domaine principal déjà connu :
#
#   DJANGO_ALLOWED_HOSTS=bibtotanga.com,www.bibtotanga.com,gestion.bibtotanga.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://bibtotanga.com,https://www.bibtotanga.com,https://gestion.bibtotanga.com
#   CORS_ALLOWED_ORIGINS=https://bibtotanga.com,https://www.bibtotanga.com,https://gestion.bibtotanga.com
#
# Pour un essai local de la stack production en HTTP :
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#   DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
#   CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
#   DJANGO_SECURE_SSL_REDIRECT=false
# ---------------------------------------------------------------------------
# DJANGO_ALLOWED_HOSTS=bibtotanga.com,www.bibtotanga.com,SOUS_DOMAINE_ADMIN.bibtotanga.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://bibtotanga.com,https://www.bibtotanga.com,https://SOUS_DOMAINE_ADMIN.bibtotanga.com
# CORS_ALLOWED_ORIGINS=https://bibtotanga.com,https://www.bibtotanga.com,https://SOUS_DOMAINE_ADMIN.bibtotanga.com
# DJANGO_SECURE_SSL_REDIRECT=true
