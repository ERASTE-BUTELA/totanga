# Copier ce fichier vers .env puis remplacer les valeurs.
# .env n'est pas versionné.

DJANGO_SECRET_KEY=changez-moi
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=totanga
POSTGRES_USER=totanga
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Compte créé au premier démarrage seulement. Valeurs factices : à remplacer.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changez-moi
