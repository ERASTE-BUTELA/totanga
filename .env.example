# Modèle à copier vers .env (jamais versionné).
# Sur le VPS : cp .env.example .env  puis remplacer uniquement les secrets.
# En développement local : garder les hôtes localhost (voir section bas de fichier).

# ---------------------------------------------------------------------------
# Secrets — à changer obligatoirement
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=changez-moi-par-une-cle-longue-et-aleatoire
POSTGRES_PASSWORD=changez-moi
DJANGO_SUPERUSER_PASSWORD=changez-moi

# Compte administrateur du quotidien (créé au premier démarrage seulement)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@bibtotanga.com

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=totanga
POSTGRES_USER=totanga
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Production (VPS) — domaine principal bibtotanga.com
# Remplacer SOUS_DOMAINE_ADMIN quand le sous-domaine d'administration est choisi
# (ex. gestion → gestion.bibtotanga.com).
# ---------------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=bibtotanga.com,www.bibtotanga.com,SOUS_DOMAINE_ADMIN.bibtotanga.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bibtotanga.com,https://www.bibtotanga.com,https://SOUS_DOMAINE_ADMIN.bibtotanga.com
CORS_ALLOWED_ORIGINS=https://bibtotanga.com,https://www.bibtotanga.com,https://SOUS_DOMAINE_ADMIN.bibtotanga.com
DJANGO_SECURE_SSL_REDIRECT=true

# ---------------------------------------------------------------------------
# Développement local uniquement (docker compose up)
# Décommenter / utiliser ces lignes à la place du bloc Production ci-dessus.
# ---------------------------------------------------------------------------
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:5174
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# DJANGO_SECURE_SSL_REDIRECT=false
